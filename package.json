{
  "name": "frame-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "ai:prepare": "node scripts/ai-composer/export-ai-data.mjs && node scripts/ai-composer/generate-recipes.mjs",
    "ai:recipes": "node scripts/ai-composer/generate-recipes.mjs",
    "ai:evaluate": "node scripts/ai-composer/evaluate-components.mjs",
    "ai:mcp": "node scripts/ai-composer/mcp-server.mjs",
    "ai:mcp:test": "node scripts/ai-composer/test-mcp-poc.mjs",
    "qa:docs": "node scripts/qa-doc-examples.mjs",
    "start:playground": "ng serve playground",
    "start:template-store": "ng serve template-store",
    "start:template-administration": "ng serve template-administration",
    "start:docs": "ng serve docs",
    "watch": "ng build foundation --watch --configuration development",
    "watch:components": "ng build components --watch --configuration development",
    "watch:charts": "ng build charts --watch --configuration development",
    "test": "ng test foundation --watch=false && ng test components --watch=false && ng test charts --watch=false",
    "test:components": "ng test components --watch=false",
    "test:charts": "ng test charts --watch=false",
    "test:playground": "ng test playground --watch=false",
    "serve:ssr:docs": "node dist/docs/server/server.mjs",
    "build:playground": "ng build playground",
    "build:template-store": "ng build template-store",
    "build:template-administration": "ng build template-administration",
    "build:templates": "npm run build:template-store && npm run build:template-administration",
    "build:docs": "ng build docs",
    "build:foundation": "ng build foundation --configuration production",
    "build:components": "ng build components --configuration production",
    "build:charts": "ng build charts --configuration production",
    "build:packages": "npm run build:foundation && npm run build:components && npm run build:charts",
    "pack:foundation": "cd dist/foundation && npm pack --dry-run",
    "pack:components": "cd dist/components && npm pack --dry-run",
    "pack:charts": "cd dist/charts && npm pack --dry-run",
    "publish:charts": "ng build charts --configuration production && cd dist/charts && npm publish --access public --tag latest",
    "publish:foundation": "ng build foundation --configuration production && cd dist/foundation && npm publish --access public --tag latest",
    "publish:components": "ng build components --configuration production && cd dist/components && npm publish --access public --tag latest"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/platform-server": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@angular/ssr": "^21.2.21",
    "@ng-icons/core": "^33.2.3",
    "@ng-icons/tabler-icons": "^33.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0",
    "rxjs": "~7.8.2",
    "shiki": "^4.4.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "json-server": "^1.0.0-beta.15",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
